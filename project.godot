; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LoWTide"
run/main_scene="res://scenes/tests/animation_test.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

player_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
player_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
player_jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
player_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
player_sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
player_hook={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325,"location":2)]
}
player_interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
player_grab={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
practice_hurt={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":72)]
}
practice_reset={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

[layer_names]

2d_physics/layer_1="Terrain"
2d_physics/layer_2="Hook targets"
2d_physics/layer_3="Interactables"
2d_physics/layer_4="Pushable bodies"
2d_physics/layer_5="Water"
2d_physics/layer_6="Player"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
